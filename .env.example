# TutorSystem-Kate Environment Configuration
# ─────────────────────────────────────────────

# Server Port (default: 3001)
PORT=3001

# ─── Firebase Configuration ─────────────────
# Option 1: Service Account JSON file (place firebase-key.json in /server/)
# FIREBASE_SERVICE_ACCOUNT=./server/firebase-key.json

# Option 2: Environment variables
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Account Setup (seed via POST /api/auth/seed) ───
# Default local accounts (no Firebase needed):
#   Admin:   admin@tutorsystem.local / admin123
#   Student: katelyn@tutorsystem.local / kate123
